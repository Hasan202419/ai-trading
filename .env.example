NODE_ENV=development
PORT=3000
MCP_PORT=3333
WORKER_INTERVAL_MS=60000
OPENAI_APPS_CHALLENGE_TOKEN=

# Safety: v1 is paper trading only. Do not change to live without a new review.
TRADING_MODE=paper
REQUIRE_MANUAL_APPROVAL=true

# Alpaca paper trading
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex
ALPACA_DATA_DELAY_MINUTES=15

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# OpenAI advisory-only analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Read-only market data providers
MARKET_DATA_PROVIDER=auto
MARKET_DATA_PROVIDER_PRIORITY=alpaca,yahoo,massive,finnhub
MARKET_DATA_DEFAULT_SYMBOL=SPY
MARKET_DATA_DEFAULT_TIMEFRAME=1
YAHOO_FINANCE_ENABLED=true
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
YAHOO_FINANCE_DATA_DELAY_MINUTES=15
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_DATA_DELAY_MINUTES=15
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_DATA_DELAY_MINUTES=0
FINVIZ_API_KEY=
FINVIZ_BASE_URL=
FINVIZ_DATA_DELAY_MINUTES=15

# Render deploy automation
RENDER_API_KEY=

# Public URLs after Render deploy
APP_PUBLIC_URL=http://localhost:3000
MCP_PUBLIC_URL=http://localhost:3333
